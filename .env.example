SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paid-only examples: gemini-3.1-pro-preview, gemini-2.5-pro
# AI summary + Ideas return English + 中文. Ideas = screen shortlist → AI rank.
CORS_ALLOW_ORIGINS=*
SNAPSHOT_TTL_SECONDS=21600
# Shared site password. Leave empty for local-only open access.
# Set this on Render so the Netlify site asks for a password.
SITE_PASSWORD=
# Outbound Ideas webhook (Google Apps Script /exec URL). Empty = off. Do not commit real URLs.
# IDEAS_WEBHOOK_URL=
# Optional. Apps Script cannot read headers — check JSON field `secret` in doPost.
# IDEAS_WEBHOOK_SECRET=
# POLICY_MECHANICAL_BUY_NEW=false
